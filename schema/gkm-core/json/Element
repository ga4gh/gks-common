{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/Element",
   "title": "Element",
   "maturity": "trial use",
   "type": "object",
   "abstract": true,
   "description": "The base definition for all identifiable data objects.",
   "properties": {
      "id": {
         "type": "string",
         "description": "The 'logical' identifier of the data element in the system of record, e.g. a UUID.  This 'id' is unique within a given system, but may or may not be globally unique outside the system. It is used within a system to reference an object from another."
      },
      "extensions": {
         "type": "array",
         "ordered": false,
         "items": {
            "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/Extension"
         },
         "description": "A list of extensions to the Entity, that allow for capture of information not directly supported by elements defined in the model."
      }
   }
}
